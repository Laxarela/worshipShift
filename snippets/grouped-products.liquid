{% comment %} adding the styling file in order to style the table {% endcomment %}
{{ 'grouped-products.css' | asset_url | stylesheet_tag }}

<div id="skuTableContainer">
  <table id="skuTable">
    <thead>
      <tr>
        <th>Product Title</th>
        <th>SKU</th>
        <th>Product Link</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<script>
document.addEventListener("DOMContentLoaded", async function () {
    let skuString = "{{ product.metafields.custom.list_of_sku }}"; 

    console.log("Raw SKU String:", skuString);

    if (!skuString) {
        console.log("No SKU found.");
        return;
    }

    // Remove trailing commas and split into an array
    let skuArray = skuString.replace(/,$/, "").split(",").map(s => s.trim());

    console.log("Cleaned SKU List:", skuArray);

    // Fetch products for each SKU
    for (const sku of skuArray) {
        await fetchProductsBySKU(sku);
    }
});

async function fetchProductsBySKU(sku) {
    const query = `{
      products(first: 10, query: "sku:${sku}") {
        edges {
          node {
            id
            title
            handle
            metafield(namespace: "custom", key: "list_of_sku") {
              value
            }
          }
        }
      }
    }`;

    const response = await fetch("https://lela-test.myshopify.com/api/2024-04/graphql.json", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-Shopify-Storefront-Access-Token":STORE_FRONT_API_DATA
        },
        body: JSON.stringify({ query })
    });

    const result = await response.json();
    console.log("GraphQL Response:", result);
    populateTable(result.data.products.edges);
}

function populateTable(products) {
    const tbody = document.querySelector("#skuTable tbody");
    tbody.innerHTML = "";

    products.forEach(product => {
        const row = document.createElement("tr");
        row.innerHTML = `
            <td>${product.node.title}</td>
           <td>${product.node.metafield ? product.node.metafield.value : "N/A"}</td>
         
            <td><a href="/products/${product.node.handle}" target="_blank">View</a></td>
        `;
        tbody.appendChild(row);
    });
}
</script>
